# Copy to .env.local and fill in. Never commit real values.

# Last.fm API key (https://www.last.fm/api/account/create) - server-side only.
# Without it the app runs in mock mode with a small bundled catalogue.
LASTFM_API_KEY=

# LLM providers for the "why it's similar" explanations (both have free tiers).
# Without either, explanations fall back to a deterministic tag-based template.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional overrides
# LLM_PROVIDER=auto        # auto | gemini | groq | none
# GEMINI_MODEL=gemini-3.1-flash-lite,gemini-flash-lite-latest   # comma list, tried in order
# GROQ_MODEL=openai/gpt-oss-20b
# MOCK_MODE=0              # 1 forces mock data even when keys exist

# Optional persistent cache (Upstash Redis / Vercel KV free tier). Without it the in-memory cache is used.
# Create a free Redis DB at https://console.upstash.com and copy the REST URL + token
# (Vercel's KV integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which are also understood).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
